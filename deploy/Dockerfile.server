# Multi-stage build for csx-server: static binary on alpine.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/csx-server ./cmd/csx-server

FROM alpine:3.22
ARG CSX_VERSION=dev
ENV CSX_VERSION=$CSX_VERSION
LABEL org.opencontainers.image.revision=$CSX_VERSION
RUN apk add --no-cache ca-certificates tzdata wget && adduser -D -H csx
# Named volumes inherit ownership from the image, so the blob dir must exist
# and belong to the runtime user before the volume is created.
RUN mkdir -p /data/blobs /data/dist && chown -R csx:csx /data
COPY --from=build /out/csx-server /usr/local/bin/csx-server
# The /adapters page and /v1 fallback read this from the working directory.
COPY --from=build /src/schemas/v1/adapters.json /schemas/v1/adapters.json
WORKDIR /
USER csx
EXPOSE 8080
ENTRYPOINT ["csx-server"]
CMD ["serve"]
