# CADDY_SITE selects the site address:
#   production: "codesamplex.dev"  (automatic HTTPS)
#   local:      ":80"
# Only names that actually resolve to this host belong here — Caddy asks a
# CA for a certificate per name, and an unresolvable name fails that
# challenge forever. Add "www.codesamplex.dev" to CADDY_SITE once a www
# record exists; a redirect block for it would duplicate the address.
{$CADDY_SITE::80} {
	encode zstd gzip

	@static path /static/* /install.ps1 /install.sh /robots.txt /sitemap.xml
	header @static Cache-Control "public, max-age=3600"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy server:8080
}
