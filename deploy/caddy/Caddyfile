# CADDY_SITE selects the site address(es):
#   production: "codesamplex.dev, www.codesamplex.dev"  (automatic HTTPS)
#   local:      ":80"
# Only names that actually resolve to this host belong here — Caddy asks a
# CA for a certificate per name, and an unresolvable name fails that
# challenge forever. A name listed here must NOT also get its own block:
# duplicating an address makes Caddy refuse the whole config.
{$CADDY_SITE::80} {
	# www serves the same site; canonical URLs and sitemaps point at the
	# apex, so search engines still index one host.
	@www host www.codesamplex.dev
	redir @www https://codesamplex.dev{uri} permanent

	encode zstd gzip

	@static path /static/* /install.ps1 /install.sh /robots.txt /sitemap.xml
	header @static Cache-Control "public, max-age=3600"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Access log, deliberately without the client address.
	#
	# There was no log at all, so nobody could answer "is anyone visiting"
	# — and the one number that looked like an answer (peers) only moves
	# after somebody INSTALLS and RUNS csx, which is several steps past a
	# first visit. A project that says it will turn sign-in on when traffic
	# appears has to be able to see traffic appear.
	#
	# remote_ip is dropped rather than kept: an IP is personal data, this
	# network's whole posture is that it does not collect any (goal.md
	# §8.6), and it is not needed to answer the question. What is left says
	# WHAT was fetched and HOW OFTEN — which is what "is anyone here" means.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		# The client address and headers are DELETED from every line, not
		# merely unused. An IP is personal data, and the peer announce
		# handler still needs the real X-Forwarded-For to work, so the
		# stripping happens here — in the log — rather than on the request.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				resp_headers delete
			}
		}
		level INFO
	}

	reverse_proxy server:8080
}
