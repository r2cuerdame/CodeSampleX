# CADDY_SITE selects the site address(es):
#   production: "codesamplex.dev, www.codesamplex.dev"  (automatic HTTPS)
#   local:      ":80"
# Only names that actually resolve to this host belong here — Caddy asks a
# CA for a certificate per name, and an unresolvable name fails that
# challenge forever. A name listed here must NOT also get its own block:
# duplicating an address makes Caddy refuse the whole config.
{$CADDY_SITE::80} {
	# www serves the same site; canonical URLs and sitemaps point at the
	# apex, so search engines still index one host.
	@www host www.codesamplex.dev
	redir @www https://codesamplex.dev{uri} permanent

	encode zstd gzip

	@static path /static/* /install.ps1 /install.sh /robots.txt /sitemap.xml
	header @static Cache-Control "public, max-age=3600"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The private operator dashboard needs API request volume, not identities.
	# Keep a dedicated, privacy-safe log instead of exposing the historical
	# access.log (which predates query stripping) to the application container.
	# This safe API activity/access-log collector drops remote_ip because an IP
	# is personal data and is not needed to count endpoint activity. These
	# counters answer which API route groups ran and how often; this statement
	# is deliberately limited to this collector. Other CodeSampleX server
	# features have their own documented storage and privacy boundaries.
	# In particular, the application separately stores key-scoped network
	# pseudonyms in activity_buckets: CSX_ACTIVITY_HASH_KEY is their privacy
	# boundary, and IPv4 buckets are enumerable if that colocated key is lost.
	# Website, admin and health-check traffic are not API calls and would burn
	# the bounded retention window without improving this metric.
	# Allowlist only route families owned by this server. If an unknown 404
	# contains a user-controlled segment, it must never reach the safe log.
	@skipAPIMetrics not path /v1/search /v1/evidence /v1/evidence/* /v1/registry /v1/registry/* /v1/shards /v1/shards/* /v1/samples /v1/samples/* /v1/wanted /v1/wanted/* /v1/adoptions /v1/adoptions/* /v1/verifications /v1/verifications/* /v1/verification /v1/verification/* /v1/peers /v1/peers/* /v1/stats /v1/adapters /v1/auth /v1/auth/* /v1/authoring/session/refresh /v1/authoring/drafts /v1/authoring/work/next
	log_skip @skipAPIMetrics
	# Append the fixed label selected by Caddy's decoded path matcher, then
	# delete the URI wholesale in the encoder below. Merely truncating the raw
	# URI is insufficient: an encoded slash such as %2F can match a known route
	# after decoding while still carrying user-controlled bytes in one raw
	# segment.
	@apiSearch path /v1/search
	log_append @apiSearch csx_route search
	@apiEvidence path /v1/evidence /v1/evidence/*
	log_append @apiEvidence csx_route evidence
	@apiRegistry path /v1/registry /v1/registry/*
	log_append @apiRegistry csx_route registry
	@apiShards path /v1/shards /v1/shards/*
	log_append @apiShards csx_route shards
	@apiSamples path /v1/samples /v1/samples/*
	log_append @apiSamples csx_route samples
	@apiWanted path /v1/wanted /v1/wanted/*
	log_append @apiWanted csx_route wanted
	@apiAdoptions path /v1/adoptions /v1/adoptions/*
	log_append @apiAdoptions csx_route adoption
	@apiVerifications path /v1/verifications /v1/verifications/*
	log_append @apiVerifications csx_route verifications
	@apiVerificationJobs path /v1/verification /v1/verification/*
	log_append @apiVerificationJobs csx_route verification_jobs
	@apiPeers path /v1/peers /v1/peers/*
	log_append @apiPeers csx_route peers
	@apiStats path /v1/stats
	log_append @apiStats csx_route stats
	@apiAdapters path /v1/adapters
	log_append @apiAdapters csx_route adapters
	@apiAuth path /v1/auth /v1/auth/*
	log_append @apiAuth csx_route auth
	@apiAuthoringRefresh path /v1/authoring/session/refresh
	log_append @apiAuthoringRefresh csx_route authoring_refresh
	@apiAuthoringDraft path /v1/authoring/drafts
	log_append @apiAuthoringDraft csx_route authoring_draft
	@apiAuthoringWork path /v1/authoring/work/next
	log_append @apiAuthoringWork csx_route authoring_work
	# HTTP method tokens are client-controlled too. Store only the three
	# buckets the dashboard uses, never the raw token.
	@methodGetHead method GET HEAD
	log_append @methodGetHead csx_method get_head
	@methodPost method POST
	log_append @methodPost csx_method post
	@methodOther not method GET HEAD POST
	log_append @methodOther csx_method other

	log {
		output file /var/log/caddy-safe/access-safe.log {
			mode 0644
			roll_size 10MiB
			# Force a daily boundary even when traffic never reaches 10 MiB,
			# otherwise the current file can outlive the 31-day roll policy.
			# roll_interval is checked on writes; the UTC midnight timer also
			# closes an idle current file so retention is bounded at rest.
			roll_interval 24h
			roll_at 00:00
			# Worst-case disk ceiling is about 410 MiB (current + 40 rolls).
			# Caddy compresses rolls, and age retention prevents stale growth.
			roll_keep 40
			roll_keep_for 744h
		}
		# The request-dependent fields kept are status, coarse method and the
		# fixed csx_route label above (alongside Caddy's constant log
		# metadata/timestamp). Delete the entire request object before bytes
		# reach disk so future Caddy request fields cannot widen collection.
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				bytes_read delete
				duration delete
				size delete
				user_id delete
			}
		}
		level INFO
	}

	reverse_proxy server:8080
}
