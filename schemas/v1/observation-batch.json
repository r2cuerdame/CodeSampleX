{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codesamplex.dev/schemas/v1/observation-batch.json",
  "title": "ObservationBatch",
  "description": "Anonymous automatic evidence unit. Must never carry source, paths, project names, secrets, or raw logs.",
  "type": "object",
  "required": ["schemaVersion", "epoch", "anonId", "projectBucket", "package", "environment", "stage", "result", "observationCount"],
  "properties": {
    "schemaVersion": {"const": 1},
    "epoch": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "anonId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "projectBucket": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "package": {"type": "string", "pattern": "^pkg:(npm|pypi|cargo|golang)/.+@.+$"},
    "symbol": {"type": "string"},
    "symbolConfidence": {"enum": ["EXACT", "PROBABLE", "UNKNOWN"]},
    "environment": {"$ref": "environment.json"},
    "stage": {"enum": ["USED", "PROJECT_TYPECHECK", "PROJECT_COMPILE", "PROJECT_TEST", "PROJECT_PROCESS"]},
    "result": {"enum": ["PASS", "FAIL"]},
    "observationCount": {"type": "integer", "minimum": 1},
    "errorFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "errorCode": {"type": "string", "maxLength": 64}
  },
  "additionalProperties": false
}
