{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codesamplex.dev/schemas/v2/verification-receipt.json",
  "title": "VerificationReceipt",
  "description": "Immutable signed record of one sample verification in one environment.",
  "type": "object",
  "required": ["schemaVersion", "sampleId", "caseId", "environmentHash", "environment", "stages", "verifierAdapter", "sandboxCapability", "logsDigest", "createdAt", "peerId", "peerPubkey", "peerSignature"],
  "properties": {
    "schemaVersion": {"const": 2},
    "sampleId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "caseId": {"type": "string"},
    "environmentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {"$ref": "../v1/environment.json"},
    "stages": {
      "type": "object",
      "additionalProperties": {"enum": ["PASS", "FAIL", "SKIPPED"]}
    },
    "stageFailures": {
      "type": "object",
      "description": "Secret-safe structured failure evidence keyed by failed stage. Raw logs remain local.",
      "additionalProperties": {
        "type": "object",
        "required": ["evidenceQuality"],
        "properties": {
          "terminationKind": {"enum": ["exit", "signal", "timeout", "process-start-failed"]},
          "exitCode": {"type": "integer"},
          "signal": {"type": "string", "maxLength": 32},
          "timeoutMillis": {"type": "integer", "minimum": 0},
          "errorSummary": {"type": "string", "maxLength": 512},
          "errorCode": {"type": "string", "maxLength": 64},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "evidenceQuality": {"enum": ["complete", "partial", "missing"]},
          "outerCommand": {"type": "string", "pattern": "^[a-z0-9]+(?: [a-z0-9-]+)?$", "maxLength": 32},
          "outerStage": {"type": "string", "maxLength": 32},
          "actualToolchain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._/-]{0,63}$"},
          "stageEvidence": {"enum": ["structured-termination", "resolve-diagnostic", "compiler-diagnostic", "test-runner-diagnostic", "build-aggregate", "unclassified-diagnostic"]},
          "evidenceGap": {"enum": ["diagnostic-missing", "stage-unknown"]}
        },
        "additionalProperties": false
      }
    },
    "resolvedPackages": {
      "type": "array",
      "description": "Package versions established by a successful resolve stage. Omitted when resolution did not run or the installed version could not be established.",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^pkg:[^/]+/.+@[^@]+$"},
      "uniqueItems": true
    },
    "verifierImage": {
      "type": "object",
      "description": "Immutable identity of the container image the stages ran in. Omitted when not established: the native fallback runner has no image, and receipts signed before this field existed carry none. Never read an omitted value as the default image.",
      "required": ["reference", "digest"],
      "properties": {
        "reference": {
          "type": "string",
          "description": "Canonical immutable reference, <alias>@sha256:<hex>. The alias is readable; the digest is the execution authority.",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "type": "string",
          "description": "Registry content digest of the image index. Must equal the digest in reference. Deliberately not the daemon's local image ID, which differs between image store implementations for byte-identical images.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "verifierAdapter": {"type": "string"},
    "sandboxCapability": {"enum": ["COMPILE_ONLY", "CONTAINER_RUN", "STRONG_ISOLATION_RUN", "LIVE_INTEGRATION"]},
    "logsDigest": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "peerId": {"type": "string", "pattern": "^ed25519:[0-9a-f]{16}$"},
    "peerPubkey": {"type": "string"},
    "peerSignature": {"type": "string"}
  },
  "additionalProperties": false
}
