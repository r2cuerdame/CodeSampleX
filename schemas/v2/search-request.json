{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codesamplex.dev/schemas/v2/search-request.json",
  "title": "SearchRequest",
  "type": "object",
  "required": ["schemaVersion", "query", "environment"],
  "properties": {
    "schemaVersion": {"const": 2},
    "query": {"type": "string"},
    "packages": {"type": "array", "items": {"type": "string"}},
    "projectPackages": {"type": "array", "items": {"type": "string"}},
    "contextSymbols": {"type": "array", "items": {"type": "string"}},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "symbolProvenance": {"enum": ["explicit", "context"]},
    "environment": {"$ref": "../v1/environment.json"},
    "environmentProvenance": {"enum": ["explicit", "context"]},
    "errorFingerprint": {"type": "string"},
    "errorFingerprints": {"type": "array", "items": {"type": "string"}},
    "errorCode": {"type": "string"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 10}
  },
  "additionalProperties": false
}
